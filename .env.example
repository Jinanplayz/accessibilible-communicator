# Copy to .env (which is gitignored) and fill in, or set these in your shell /
# hosting provider's dashboard. Every value here is optional.

# --- Your ElevenLabs key ----------------------------------------------------
# Only used when the browser making the request is on the SAME MACHINE as the
# server (i.e. you running it locally). Remote visitors are never served this
# key; they supply their own from the page. Alternative to credentials.json.
ELEVENLABS_API_KEY=

# --- Deployment mode --------------------------------------------------------
# Set to 1 for ANY deployment that is not your own laptop. Disables writing
# credentials.json and disables all use of a server-side key.
VOICEFLOW_PUBLIC=

# Set to 1 if a reverse proxy (nginx, Caddy, Cloudflare, a PaaS router) sits in
# front of the app. Makes the app read client IPs from X-Forwarded-For and
# stops it from ever mistaking a proxied visitor for a local one.
VOICEFLOW_BEHIND_PROXY=

# Comma-separated origins allowed to open WebSockets, e.g.
# https://voiceflow.example.com. Leave blank to require that the WebSocket
# Origin matches the request Host (correct for most single-domain deploys).
VOICEFLOW_ALLOWED_ORIGINS=

# --- Local dev only ---------------------------------------------------------
# Used by `python main.py`. Defaults to loopback so the app is not accidentally
# exposed to your local network.
VOICEFLOW_HOST=127.0.0.1
VOICEFLOW_PORT=8000
